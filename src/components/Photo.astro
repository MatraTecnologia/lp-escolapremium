---
interface Props {
  src?: string;
  alt: string;
  label?: string;
  class?: string;
  tone?: "navy" | "royal" | "mist";
}
const { src, alt, label, class: className = "", tone = "navy" } = Astro.props;

const tones = {
  navy: "from-navy to-royal text-white/70",
  royal: "from-royal to-navy text-white/70",
  mist: "from-mist to-royal-100 text-navy/50",
};
---
{
  src ? (
    <img src={src} alt={alt} class={`h-full w-full object-cover ${className}`} loading="lazy" />
  ) : (
    <div
      class={`relative flex h-full w-full items-center justify-center overflow-hidden bg-gradient-to-br ${tones[tone]} ${className}`}
      role="img"
      aria-label={alt}
    >
      <svg class="absolute inset-0 h-full w-full opacity-[0.07]" aria-hidden="true">
        <defs>
          <pattern id="ph-dots" width="22" height="22" patternUnits="userSpaceOnUse">
            <circle cx="2" cy="2" r="1.5" fill="currentColor" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#ph-dots)" />
      </svg>
      <div class="relative flex flex-col items-center gap-2 px-4 text-center">
        <svg viewBox="0 0 24 24" class="h-8 w-8 opacity-60" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <rect x="3" y="4" width="18" height="16" rx="2" />
          <circle cx="9" cy="10" r="2" />
          <path d="m3 17 5-4 4 3 3-2 6 5" />
        </svg>
        {label && <span class="text-xs font-semibold uppercase tracking-wider">{label}</span>}
      </div>
    </div>
  )
}
