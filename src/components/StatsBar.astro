---
import Icon from "./Icon.astro";
import { stats } from "../data/site";
---
<section class="relative z-10 -mt-8 sm:-mt-12" aria-label="Números da Escola Premium">
  <div class="u-container">
    <div class="grid gap-6 rounded-3xl bg-white px-6 py-8 shadow-float sm:grid-cols-2 sm:px-10 lg:grid-cols-4">
      {
        stats.map((s) => (
          <div class="flex items-start gap-4">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-royal-100 text-royal">
              <Icon name={s.icon} class="h-6 w-6" />
            </span>
            <div>
              <p class="font-display text-2xl font-extrabold leading-none text-navy">{s.value}</p>
              <p class="mt-1.5 text-sm leading-snug text-slate">{s.label}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
