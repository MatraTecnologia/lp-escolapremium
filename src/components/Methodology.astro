---
import Icon from "./Icon.astro";
import { stages, highlight } from "../data/site";
---
<section id="metodologia" class="bg-mist py-20 sm:py-28">
  <div class="u-container">
    <div class="max-w-2xl">
      <p class="u-eyebrow">
        <Icon name="star" class="h-4 w-4 text-gold" /> Nossa Metodologia
      </p>
      <h2 class="mt-4 text-3xl font-extrabold text-navy sm:text-4xl">
        Cada fase do desenvolvimento merece atenção especial.
      </h2>
      <p class="mt-4 text-slate">
        Uma trilha pedagógica contínua, do berçário ao Fundamental I, apropriada para o máximo
        potencial de cada idade.
      </p>
    </div>

    <ol class="relative mt-14 grid gap-8 md:grid-cols-4">
      <span class="absolute left-0 right-0 top-8 hidden h-px bg-navy/15 md:block" aria-hidden="true"></span>
      {
        stages.map((s, i) => (
          <li class="relative">
            <div class="flex items-center gap-3 md:block">
              <span class="relative z-10 flex h-16 w-16 items-center justify-center rounded-2xl bg-white text-royal shadow-card ring-1 ring-navy/8">
                <Icon name={s.icon} class="h-8 w-8" />
                <span class="absolute -right-2 -top-2 flex h-6 w-6 items-center justify-center rounded-full bg-gold font-display text-xs font-extrabold text-navy">
                  {i + 1}
                </span>
              </span>
            </div>
            <h3 class="mt-5 text-lg font-bold text-navy">{s.title}</h3>
            <p class="mt-0.5 text-sm font-semibold text-royal">{s.age}</p>
            <p class="mt-2 text-sm leading-relaxed text-slate">{s.text}</p>
          </li>
        ))
      }
    </ol>

    <div class="mt-14">
      <div class="max-w-2xl">
        <h3 class="text-2xl font-extrabold text-navy sm:text-3xl">As bases do nosso ensino</h3>
        <p class="mt-3 text-slate">
          Uma proposta que une acolhimento e uma trilha de aprendizagem estruturada.
        </p>
      </div>
      <div class="mt-6 grid gap-5 sm:grid-cols-2">
        <div class="flex flex-col items-center rounded-2xl bg-white p-6 text-center shadow-card sm:p-8">
          <img src="/pedagogia.png" alt="Pedagogia Afetiva" class="h-32 w-48 object-contain" loading="lazy" />
          <h4 class="mt-3 text-lg font-bold text-navy">Pedagogia Afetiva</h4>
          <p class="mt-2 max-w-xs text-sm leading-relaxed text-slate">
            O cuidado e os vínculos fazem parte da experiência de aprender.
          </p>
        </div>
        <div class="flex flex-col items-center rounded-2xl bg-white p-6 text-center shadow-card sm:p-8">
          <img src="/maxi.png" alt="Sistema Maxi de Ensino" class="h-32 w-48 object-contain" loading="lazy" />
          <h4 class="mt-3 text-lg font-bold text-navy">Sistema Maxi de Ensino</h4>
          <p class="mt-2 max-w-xs text-sm leading-relaxed text-slate">
            Material didático que acompanha o desenvolvimento dos alunos.
          </p>
        </div>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:justify-between rounded-2xl bg-navy px-6 py-5 sm:px-8">
      <p class="flex items-center gap-3 font-display text-lg font-bold text-white">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-gold text-navy">
          <Icon name="apple" class="h-6 w-6" />
        </span>
        {highlight}
      </p>
      <a
        href="#contato"
        class="inline-flex shrink-0 items-center gap-2 rounded-full bg-gold px-6 py-3 font-bold text-navy transition-transform hover:-translate-y-0.5"
      >
        Agendar Visita
        <Icon name="calendar" class="h-4 w-4" />
      </a>
    </div>
  </div>
</section>
