---
import Icon from "./Icon.astro";
import { nav } from "../data/site";
---
<header id="topo" class="fixed inset-x-0 top-0 z-50 transition-all duration-300" data-header>
  <nav class="u-container flex items-center justify-between gap-6 py-4">
    <a href="#inicio" class="flex items-center gap-2" aria-label="Escola Premium — início">
      <img src="/logo-horizontal.svg" alt="Escola Premium" class="u-logo-white h-9 w-auto" data-logo />
    </a>

    <ul class="hidden items-center gap-1 lg:flex" data-menu>
      {
        nav.map((item, i) => (
          <li>
            <a
              href={item.href}
              class="relative rounded-full px-3 py-2 text-sm font-medium text-white/85 transition-colors hover:text-white data-[nav]:text-white"
              data-nav-link={i === 0 ? "active" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-3">
      <a
        href="#contato"
        class="hidden items-center gap-2 rounded-full bg-gold px-5 py-2.5 text-sm font-bold text-navy shadow-sm transition-transform hover:-translate-y-0.5 sm:inline-flex"
      >
        Agendar Visita
        <Icon name="calendar" class="h-4 w-4" />
      </a>
      <button
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-full text-white lg:hidden"
        aria-label="Abrir menu"
        aria-expanded="false"
        data-menu-toggle
      >
        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M4 7h16M4 12h16M4 17h16" data-menu-open />
          <path d="M6 6l12 12M6 18 18 6" class="hidden" data-menu-close />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile drawer -->
  <div class="hidden border-t border-white/10 bg-navy lg:hidden" data-mobile-menu>
    <ul class="u-container flex flex-col gap-1 py-4">
      {
        nav.map((item) => (
          <li>
            <a href={item.href} class="block rounded-xl px-4 py-3 text-base font-medium text-white/85 hover:bg-white/5" data-mobile-link>
              {item.label}
            </a>
          </li>
        ))
      }
      <li class="mt-2">
        <a href="#contato" class="flex items-center justify-center gap-2 rounded-full bg-gold px-5 py-3 text-base font-bold text-navy" data-mobile-link>
          Agendar Visita
          <Icon name="calendar" class="h-4 w-4" />
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const header = document.querySelector("[data-header]") as HTMLElement;
  const toggle = document.querySelector("[data-menu-toggle]") as HTMLButtonElement;
  const drawer = document.querySelector("[data-mobile-menu]") as HTMLElement;
  const openIcon = document.querySelector("[data-menu-open]") as SVGElement;
  const closeIcon = document.querySelector("[data-menu-close]") as SVGElement;
  const logo = document.querySelector("[data-logo]") as HTMLImageElement;
  const navLinks = Array.from(document.querySelectorAll("[data-menu] a")) as HTMLAnchorElement[];

  const setScrolled = () => {
    const scrolled = window.scrollY > 24;
    header.classList.toggle("is-scrolled", scrolled);
  };
  setScrolled();
  window.addEventListener("scroll", setScrolled, { passive: true });

  let open = false;
  toggle?.addEventListener("click", () => {
    open = !open;
    drawer.classList.toggle("hidden", !open);
    openIcon.classList.toggle("hidden", open);
    closeIcon.classList.toggle("hidden", !open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Fechar menu" : "Abrir menu");
  });
  drawer?.querySelectorAll("[data-mobile-link]").forEach((link) =>
    link.addEventListener("click", () => {
      open = false;
      drawer.classList.add("hidden");
      openIcon.classList.remove("hidden");
      closeIcon.classList.add("hidden");
      toggle.setAttribute("aria-expanded", "false");
    })
  );

  // Scrollspy: underline the section currently in view
  const sections = navLinks
    .map((l) => document.querySelector(l.getAttribute("href") || ""))
    .filter(Boolean) as HTMLElement[];
  const spy = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        const id = "#" + e.target.id;
        navLinks.forEach((l) => l.toggleAttribute("data-nav", l.getAttribute("href") === id));
      });
    },
    { rootMargin: "-45% 0px -50% 0px" }
  );
  sections.forEach((s) => spy.observe(s));
</script>

<style>
  [data-header] {
    background: transparent;
  }
  [data-header].is-scrolled {
    background: color-mix(in srgb, var(--color-navy) 92%, transparent);
    backdrop-filter: blur(10px);
    box-shadow: 0 8px 30px -12px rgba(11, 19, 80, 0.5);
  }
  [data-nav] {
    color: #fff;
  }
  [data-nav]::after {
    content: "";
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.25rem;
    height: 2px;
    border-radius: 2px;
    background: var(--color-gold);
  }
</style>
